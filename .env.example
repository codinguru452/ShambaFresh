# Local development: keep DEBUG=True. Leave TIDB_HOST blank to use db.sqlite3.
DEBUG=True
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=

# TiDB Cloud (fill these when ready to connect your local Django app to TiDB)
TIDB_HOST=
TIDB_PORT=4000
TIDB_USER=
TIDB_PASSWORD=
TIDB_DB_NAME=shambafresh
TIDB_SSL_MODE=REQUIRED
TIDB_CA_PATH=

# Daraja sandbox credentials. Keep blank until configured.
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
# Must be your deployed site's URL, e.g. https://your-app.onrender.com/mpesa/callback/
MPESA_CALLBACK_URL=
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
